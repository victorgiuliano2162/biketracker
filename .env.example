# ==========================================
# Exemplo de Variáveis de Ambiente - Trakker
# Copie este arquivo para .env e preencha os valores:
# cp .env.example .env
# ==========================================

# Chaves RSA para assinatura e validação de JWT (OAuth2)
# Podem ser geradas com:
# openssl genrsa -out private.pem 2048
# openssl rsa -in private.pem -pubout -out public.pem
JWT_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"
JWT_PUBLIC_KEY="-----BEGIN PUBLIC KEY-----\n...\n-----END PUBLIC KEY-----"

# Credenciais de Envio de E-mail (SMTP)
MAIL_USERNAME=seu_email@provedor.com
MAIL_PASSWORD=sua_senha_ou_app_password

# Credenciais MinIO S3
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=minioadmin123
